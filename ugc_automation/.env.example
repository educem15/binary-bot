# ─────────────────────────────────────────────────────────────────────────────
# UGC Automation – Environment Variables
# Copy this file to .env, fill in your keys, then: source .env
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Required ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # https://console.anthropic.com/

# TikTok Content Posting API ─────────────────────────────────────────────────
# 1. Go to https://developers.tiktok.com/ → create an app
# 2. Enable "Content Posting API" product
# 3. Generate an access token (OAuth2 flow – see README)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram / Facebook Graph API ─────────────────────────────────────────────
# 1. Go to https://developers.facebook.com/ → create an app
# 2. Add "Instagram Graph API" product
# 3. Connect your Instagram Professional account
# 4. Generate a long-lived token (60-day, renewable)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=              # Your IG Business/Creator account ID

# Optional – better voice quality ────────────────────────────────────────────
# Sign up at https://elevenlabs.io (free tier available)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel         # or any voice ID from your ElevenLabs dashboard

# Optional – stock footage ────────────────────────────────────────────────────
# Free API key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional – Amazon affiliate ─────────────────────────────────────────────────
AMAZON_AFFILIATE_TAG=yourtag-20
