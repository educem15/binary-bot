# ─────────────────────────────────────────────────────────────────────────────
# UGC Automation – Environment Variables
# Copy this file to .env, fill in your keys, then: source .env
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════
#  REQUIRED
# ══════════════════════════════════════════════════════

# Claude AI – generates all scripts
# Sign up: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ══════════════════════════════════════════════════════
#  POSTING – TikTok
# ══════════════════════════════════════════════════════
# 1. Go to https://developers.tiktok.com/ → create an app
# 2. Enable "Content Posting API" product
# 3. Complete OAuth2 flow to get access token
# Guide: https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ══════════════════════════════════════════════════════
#  POSTING – Instagram / Facebook
# ══════════════════════════════════════════════════════
# 1. Go to https://developers.facebook.com/ → create app → add Instagram product
# 2. Connect your Instagram Professional (Creator/Business) account
# 3. Generate a long-lived Page Access Token (valid 60 days, renewable)
# 4. Get your account ID: GET /me?fields=id,name with your token
# Guide: https://developers.facebook.com/docs/instagram-api/guides/reels
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ══════════════════════════════════════════════════════
#  VOICE – ElevenLabs (highly recommended)
# ══════════════════════════════════════════════════════
# Free tier: 10,000 characters/month
# Sign up: https://elevenlabs.io
# Get voice IDs from: https://elevenlabs.io/voice-library
# Best UGC voices: Rachel, Aria, Sarah, Charlotte
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel

# ══════════════════════════════════════════════════════
#  STOCK VIDEO – Pexels (free)
# ══════════════════════════════════════════════════════
# Free API key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ══════════════════════════════════════════════════════
#  CLOUD STORAGE (for Instagram – needs public video URL)
# ══════════════════════════════════════════════════════

# OPTION A: Cloudflare R2 (recommended – $0.015/GB, FREE egress)
# Sign up: https://dash.cloudflare.com → R2 Storage
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_PUBLIC_URL=https://your-r2-domain.com   (custom domain or R2.dev URL)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_URL=

# OPTION B: Backblaze B2 (10 GB free, $0.006/GB after)
# Sign up: https://www.backblaze.com/b2/sign-up.html
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_URL=

# ══════════════════════════════════════════════════════
#  AFFILIATE PROGRAMS – get paid per sale
# ══════════════════════════════════════════════════════

# Amazon Associates – 1–10% commission
# Sign up: https://affiliate-program.amazon.com/
AMAZON_AFFILIATE_TAG=yourtag-20

# TikTok Shop Affiliate – 5–20% commission (highest earner for TikTok creators)
# Sign up: TikTok app → Creator Centre → TikTok Shop Affiliate
TIKTOK_SHOP_AFFILIATE_ID=

# ShareASale – 5–30%, thousands of brands
# Sign up: https://www.shareasale.com/signup/
SHAREASALE_AFFILIATE_ID=

# Impact.com – premium brands (Canva, Airbnb, Semrush etc.)
# Sign up: https://impact.com/
IMPACT_AFFILIATE_ID=

# ClickBank – digital products, 30–75% commission
# Sign up: https://www.clickbank.com/
CLICKBANK_AFFILIATE_ID=

# LTK (LikeToKnowIt) – lifestyle/fashion creators
# Sign up: https://www.shopltk.com/
LTK_AFFILIATE_ID=
